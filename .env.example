TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Abilita il bot Telegram INTERATTIVO (polling) con comandi /value /radar /advice
TELEGRAM_BOT_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=stock_monitor/1.0
DB_PATH=data/stock_monitor.db
ALERT_CHECK_INTERVAL_MINUTES=15
LOG_LEVEL=INFO

# Analytics
# Tasso risk-free annuo (decimale) usato per il calcolo dello Sharpe Ratio
RISK_FREE_RATE=0.02

# Sicurezza
SECRET_KEY=change_this_to_a_random_32_character_secret_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

